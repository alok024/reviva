# Reviva environment variables (names only - no values).
# With none of these set, restoration and checkout run in mock mode and the app still builds.

# Replicate - enables real photo restoration.
REPLICATE_API_TOKEN=

# Pinned model versions (from each model's page on replicate.com) - required for the real
# (non-mock) restore path; the model-scoped predictions endpoint needs an explicit version
# and none is hardcoded in the app.
REPLICATE_GFPGAN_VERSION=
REPLICATE_REAL_ESRGAN_VERSION=
REPLICATE_DDCOLOR_VERSION=

# Razorpay - enables real checkout. Without these, checkout runs in mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Required to accept payment.captured webhooks at /api/checkout/webhook - without it, that
# route rejects every request in production.
RAZORPAY_WEBHOOK_SECRET=

# Cloudflare R2 - only needed if you swap in lib/imagestore/r2-adapter.ts, which is an
# unimplemented stub as shipped (see README "Going live"). Unused by the in-memory default.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Supabase - only needed if you swap in lib/store/supabase-adapter.ts, which is an
# unimplemented stub as shipped (see README "Going live"). Unused by the in-memory default.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
