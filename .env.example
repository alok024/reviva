# Reviva environment variables (names only - no values).
# With none of these set, restoration and checkout run in mock mode and the app still builds.

# Replicate - enables real photo restoration.
REPLICATE_API_TOKEN=

# Pinned model versions (from each model's page on replicate.com) - required for the real
# (non-mock) restore path; the model-scoped predictions endpoint needs an explicit version
# and none is hardcoded in the app.
REPLICATE_GFPGAN_VERSION=
REPLICATE_REAL_ESRGAN_VERSION=
REPLICATE_DDCOLOR_VERSION=

# Razorpay - enables real checkout. Without these, checkout runs in mock mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
